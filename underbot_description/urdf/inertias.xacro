<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ========================================================= -->
  <!-- INERTIA MACROS (Compliant with Isaac Sim / PhysX)          -->
  <!-- ========================================================= -->

  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${(m/12.0) * (y*y + z*z)}" ixy="0.0" ixz="0.0"
               iyy="${(m/12.0) * (x*x + z*z)}" iyz="0.0"
               izz="${(m/12.0) * (x*x + y*y)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${(m/12.0) * (3*r*r + h*h)}" ixy="0.0" ixz="0.0"
               iyy="${(m/12.0) * (3*r*r + h*h)}" iyz="0.0"
               izz="${0.5 * m * r*r}"/>
    </inertial>
  </xacro:macro>

  <!-- Drive wheel inertia (cylinder aligned along Y axis) -->
  <xacro:macro name="wheel_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${(m/12.0) * (3*r*r + h*h)}" ixy="0.0" ixz="0.0"
               iyy="${0.5 * m * r*r}" iyz="0.0"
               izz="${(m/12.0) * (3*r*r + h*h)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="m r">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${0.4 * m * r*r}" ixy="0.0" ixz="0.0"
               iyy="${0.4 * m * r*r}" iyz="0.0"
               izz="${0.4 * m * r*r}"/>
    </inertial>
  </xacro:macro>

</robot>
