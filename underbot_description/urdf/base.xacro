<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Materials -->
  <material name="dark_grey"><color rgba="0.2 0.2 0.2 1.0"/></material>
  <material name="blue"><color rgba="0.1 0.2 0.6 1.0"/></material>
  <material name="black"><color rgba="0.05 0.05 0.05 1.0"/></material>
  <material name="grey"><color rgba="0.5 0.5 0.5 1.0"/></material>

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.0325" rpy="0 0 0"/>
  </joint>

  <!-- ================= BASE (Xiaomi T12) ================= -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.0315" rpy="0 0 0"/>
      <!-- VISUALLY ACCURATE MESH -->
      <geometry><mesh filename="package://underbot_description/meshes/base.stl"/></geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.0315" rpy="0 0 0"/>
      <!-- INVISIBLE SIMPLE COLLISION FOR PERFECT PHYSICS -->
      <geometry><cylinder radius="0.175" length="0.063"/></geometry>
    </collision>
    <xacro:cylinder_inertia m="3.6" r="0.175" h="0.063"/>
  </link>

  <!-- ================= WHEELS ================= -->
  <link name="left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry><mesh filename="package://underbot_description/meshes/wheel.stl"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry><cylinder radius="0.0325" length="0.016"/></geometry>
    </collision>
    <xacro:wheel_inertia m="0.15" r="0.0325" h="0.016"/>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.120 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <link name="right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry><mesh filename="package://underbot_description/meshes/wheel.stl"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry><cylinder radius="0.0325" length="0.016"/></geometry>
    </collision>
    <xacro:wheel_inertia m="0.15" r="0.0325" h="0.016"/>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.120 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <!-- Caster Wheel -->
  <link name="caster_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.012"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.012"/></geometry>
    </collision>
    <xacro:sphere_inertia m="0.05" r="0.012"/>
  </link>
  <joint name="caster_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel"/>
    <origin xyz="0.140 0 -0.0205" rpy="0 0 0"/>
  </joint>

  <!-- ================= BODY COLUMN (Torso) ================= -->
  <link name="body_column">
    <visual>
      <origin xyz="0 0 0.225" rpy="0 0 0"/>
      <geometry><mesh filename="package://underbot_description/meshes/body_column.stl"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.225" rpy="0 0 0"/>
      <geometry><box size="0.20 0.28 0.45"/></geometry>
    </collision>
    <inertial>
      <origin xyz="-0.03 0 0.15" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.0468" ixy="0.0" ixz="0.0" iyy="0.0404" iyz="0.0" izz="0.0197"/>
    </inertial>
  </link>
  <joint name="body_column_joint" type="fixed">
    <parent link="base_link"/>
    <child link="body_column"/>
    <origin xyz="0 0 0.063" rpy="0 0 0"/>
  </joint>

</robot>
