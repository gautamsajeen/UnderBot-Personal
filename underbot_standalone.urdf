<?xml version="1.0"?>
<robot name="underbot">
  <material name="dark_grey"><color rgba="0.2 0.2 0.2 1.0"/></material>
  <material name="blue"><color rgba="0.1 0.2 0.6 1.0"/></material>
  <material name="black"><color rgba="0.05 0.05 0.05 1.0"/></material>
  <material name="orange"><color rgba="1.0 0.6 0.0 1.0"/></material>
  <material name="green"><color rgba="0.0 0.8 0.0 1.0"/></material>
  <material name="cyan"><color rgba="0.0 0.8 0.8 1.0"/></material>
  <material name="purple"><color rgba="0.6 0.0 0.8 1.0"/></material>

  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.0325" rpy="0 0 0"/>
  </joint>

  <!-- BASE -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.0315" rpy="0 0 0"/>
      <geometry><cylinder radius="0.175" length="0.063"/></geometry>
      <material name="dark_grey"/>
    </visual>
  </link>

  <!-- BODY COLUMN -->
  <link name="body_column">
    <visual>
      <origin xyz="0 0 0.225" rpy="0 0 0"/>
      <geometry><box size="0.20 0.28 0.45"/></geometry>
      <material name="blue"/>
    </visual>
  </link>
  <joint name="body_column_joint" type="fixed">
    <parent link="base_link"/>
    <child link="body_column"/>
    <origin xyz="0 0 0.063" rpy="0 0 0"/>
  </joint>

  <!-- KINECT -->
  <link name="kinect_v2">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.067 0.249 0.066"/></geometry>
      <material name="black"/>
    </visual>
  </link>
  <joint name="kinect_joint" type="fixed">
    <parent link="body_column"/>
    <child link="kinect_v2"/>
    <origin xyz="0.10 0 0.40" rpy="0 0 0"/>
  </joint>

  <!-- LIDAR -->
  <link name="lidar_mount">
    <visual>
      <origin xyz="0 0 0.009" rpy="0 0 0"/>
      <geometry><cylinder radius="0.035" length="0.018"/></geometry>
      <material name="blue"/>
    </visual>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="body_column"/>
    <child link="lidar_mount"/>
    <origin xyz="0 0 0.45" rpy="0 0 0"/>
  </joint>

  <!-- LEFT ARM -->
  <link name="l_arm_base">
    <visual>
      <origin xyz="0 0.02 0" rpy="0 0 0"/>
      <geometry><box size="0.045 0.04 0.05"/></geometry>
      <material name="orange"/>
    </visual>
  </link>
  <joint name="l_arm_mount_joint" type="fixed">
    <parent link="body_column"/>
    <child link="l_arm_base"/>
    <origin xyz="0 0.14 0.25" rpy="0 0 0"/>
  </joint>

  <link name="l_upper_arm">
    <visual>
      <origin xyz="0 0 -0.06" rpy="0 0 0"/>
      <geometry><box size="0.03 0.03 0.12"/></geometry>
      <material name="green"/>
    </visual>
  </link>
  <joint name="l_shoulder_joint" type="revolute">
    <parent link="l_arm_base"/>
    <child link="l_upper_arm"/>
    <origin xyz="0 0.04 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.87" upper="1.87" effort="8.0" velocity="3.14"/>
  </joint>

  <link name="l_forearm">
    <visual>
      <origin xyz="0 0 -0.05" rpy="0 0 0"/>
      <geometry><box size="0.025 0.025 0.10"/></geometry>
      <material name="cyan"/>
    </visual>
  </link>
  <joint name="l_elbow_joint" type="revolute">
    <parent link="l_upper_arm"/>
    <child link="l_forearm"/>
    <origin xyz="0 0 -0.12" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.11" upper="1.61" effort="6.0" velocity="3.14"/>
  </joint>

  <link name="l_wrist">
    <visual>
      <origin xyz="0 0 -0.015" rpy="0 0 0"/>
      <geometry><box size="0.025 0.025 0.03"/></geometry>
      <material name="purple"/>
    </visual>
  </link>
  <joint name="l_wrist_fixed_joint" type="fixed">
    <parent link="l_forearm"/>
    <child link="l_wrist"/>
    <origin xyz="0 0 -0.10" rpy="0 0 0"/>
  </joint>

  <!-- RIGHT ARM -->
  <link name="r_arm_base">
    <visual>
      <origin xyz="0 -0.02 0" rpy="0 0 0"/>
      <geometry><box size="0.045 0.04 0.05"/></geometry>
      <material name="orange"/>
    </visual>
  </link>
  <joint name="r_arm_mount_joint" type="fixed">
    <parent link="body_column"/>
    <child link="r_arm_base"/>
    <origin xyz="0 -0.14 0.25" rpy="0 0 0"/>
  </joint>

  <link name="r_upper_arm">
    <visual>
      <origin xyz="0 0 -0.06" rpy="0 0 0"/>
      <geometry><box size="0.03 0.03 0.12"/></geometry>
      <material name="green"/>
    </visual>
  </link>
  <joint name="r_shoulder_joint" type="revolute">
    <parent link="r_arm_base"/>
    <child link="r_upper_arm"/>
    <origin xyz="0 -0.04 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.87" upper="1.87" effort="8.0" velocity="3.14"/>
  </joint>

  <link name="r_forearm">
    <visual>
      <origin xyz="0 0 -0.05" rpy="0 0 0"/>
      <geometry><box size="0.025 0.025 0.10"/></geometry>
      <material name="cyan"/>
    </visual>
  </link>
  <joint name="r_elbow_joint" type="revolute">
    <parent link="r_upper_arm"/>
    <child link="r_forearm"/>
    <origin xyz="0 0 -0.12" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.11" upper="1.61" effort="6.0" velocity="3.14"/>
  </joint>

  <link name="r_wrist">
    <visual>
      <origin xyz="0 0 -0.015" rpy="0 0 0"/>
      <geometry><box size="0.025 0.025 0.03"/></geometry>
      <material name="purple"/>
    </visual>
  </link>
  <joint name="r_wrist_fixed_joint" type="fixed">
    <parent link="r_forearm"/>
    <child link="r_wrist"/>
    <origin xyz="0 0 -0.10" rpy="0 0 0"/>
  </joint>

</robot>
